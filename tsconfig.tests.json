{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "backend/src/**/*.ts",
    "backend/tests/**/*.ts",
    "tests/**/*.ts",
    "scripts/*.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ]
}
