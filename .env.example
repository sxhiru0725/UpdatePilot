# Copy to .env. npm run db:local generates a unique local database password instead.
DATABASE_URL=postgresql://updatepilot:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:55432/updatepilot?schema=public
PORT=4310
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development
# Optional: directory containing initdb, pg_ctl and createdb
# POSTGRES_BIN=C:/Program Files/PostgreSQL/18/bin
